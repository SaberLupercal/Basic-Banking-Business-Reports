# Copy this file to ".env" (same folder as report_job.py) and fill in the values.
# Never commit ".env" to git and never email it.
# Comments are on their own lines on purpose: do not add text after a value.

# ---- SQL Server (use a login that can ONLY execute the report procedures) ----
# Server name or IP, e.g. 192.168.1.10 or SERVERNAME\INSTANCE
SQL_SERVER=your-server-name-or-ip
SQL_DATABASE=your_database
SQL_USER=report_reader
SQL_PASSWORD=change-me
# Windows login instead of SQL_USER/SQL_PASSWORD: set SQL_TRUSTED=true
SQL_TRUSTED=false
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=yes
# "yes" accepts a self-signed certificate (typical for an internal server)
SQL_TRUST_CERT=yes
SQL_QUERY_TIMEOUT=300

# ---- Mail server ----
SMTP_HOST=smtp.your-company.vn
# 587 = STARTTLS, 465 = implicit TLS
SMTP_PORT=587
# false only for a trusted internal relay without TLS
SMTP_STARTTLS=true
# Leave SMTP_USER and SMTP_PASSWORD empty if the relay needs no login
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=bao-cao@your-company.vn
MAIL_TO=a@your-company.vn, b@your-company.vn
MAIL_CC=
# Who is told when the job fails (you)
ALERT_TO=you@your-company.vn

# ---- Output ----
OUTPUT_DIR=
# Which procedures to run and in which sheet (default: reports.json next to the script)
REPORTS_FILE=
# true = still send when a procedure returns no rows
ALLOW_EMPTY=false
MAX_ATTACH_MB=20
